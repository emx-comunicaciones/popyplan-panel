# URL base del backend Django/DRF, sin barra final.
# Obligatoria en producción: sin ella el panel lanza al primer fetch
# (`lib/api/baseUrl.ts`) en vez de apuntar en silencio a localhost.
# Fuera de producción, si falta, se usa http://localhost:8001.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Hosts https adicionales desde los que se sirven imágenes remotas
# (logos de entidad en un CDN o un bucket con dominio propio), separados
# por comas. El host de NEXT_PUBLIC_API_URL ya está permitido; esta lista
# solo hace falta si los medios NO los sirve el backend.
# Se lee al construir (`next.config.ts::images.remotePatterns`).
# NEXT_PUBLIC_MEDIA_HOSTS=cdn.popyplan.com,media.popyplan.com
